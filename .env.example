# MergerFin Configuration
# Copy this file to .env and adjust values for your environment.

# Internal HTTP listen port inside the container (or when running the binary directly)
MERGERFIN_PORT=8096

# Host port mapped by docker-compose.yml (change if 8096 is already in use on the host)
MERGERFIN_HOST_PORT=8096

# Data directory for SQLite database (mergerfin.db) and cached images
MERGERFIN_DATA_DIR=./data

# Display name reported by /System/Info/Public and Jellyfin clients
MERGERFIN_SERVER_NAME=MergerFin

# Initial admin credentials created on first startup (when no users exist)
MERGERFIN_ADMIN_USER=admin
MERGERFIN_ADMIN_PASS=change-me

# Secret key for signing/encryption; leave empty to auto-generate and persist in SQLite
MERGERFIN_SECRET_KEY=

# Background library sync interval (Go duration e.g. 30m, 1h, or integer minutes)
MERGERFIN_SYNC_INTERVAL=30m

# Log verbosity: debug, info, warn, error
MERGERFIN_LOG_LEVEL=info

# Optional host port overrides for docker-compose.dev.yml
# MERGERFIN_DEV_PORT=18096
# UPSTREAM_A_PORT=18097
# UPSTREAM_B_PORT=18098
